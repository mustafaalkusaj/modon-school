// ============================================================================
// EXAM SYSTEM (Phase 1 — additive new tables)
// ============================================================================

model ExamQuestion {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId     String    @map("exam_id") @db.Uuid
  questionId String    @map("question_id") @db.Uuid
  sortOrder  Int?      @default(0) @map("sort_order")
  marks      Decimal?  @default(1) @db.Decimal
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
  @@map("exam_questions")
}

model ExamSetting {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId                  String    @unique @map("exam_id") @db.Uuid
  durationMinutes         Int?      @map("duration_minutes")
  shuffleQuestions        Boolean?  @default(false) @map("shuffle_questions")
  shuffleOptions          Boolean?  @default(false) @map("shuffle_options")
  autoSubmit              Boolean?  @default(true) @map("auto_submit")
  showResultsImmediately  Boolean?  @default(false) @map("show_results_immediately")
  allowReview             Boolean?  @default(true) @map("allow_review")
  lockBrowser             Boolean?  @default(false) @map("lock_browser")
  maxAttempts             Int?      @default(1) @map("max_attempts")
  passingMarks            Decimal?  @map("passing_marks") @db.Decimal
  instructions            String?
  createdAt               DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([examId])
  @@map("exam_settings")
}

model StudentAnswer {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId        String    @map("attempt_id") @db.Uuid
  questionId       String    @map("question_id") @db.Uuid
  studentAnswer    Json?     @map("student_answer")
  isCorrect        Boolean?  @map("is_correct")
  marksAwarded     Decimal?  @default(0) @map("marks_awarded") @db.Decimal
  timeSpentSeconds Int?      @map("time_spent_seconds")
  flagged          Boolean?  @default(false)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("student_answers")
}

model ExamIntegrityLog {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId String    @map("attempt_id") @db.Uuid
  eventType String    @map("event_type")
  metadata  Json?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([attemptId])
  @@map("exam_integrity_logs")
}

model ExamRubric {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  criteria   String
  maxMarks   Decimal  @map("max_marks") @db.Decimal
  sortOrder  Int?     @default(0) @map("sort_order")

  @@index([questionId])
  @@map("exam_rubrics")
}

model ExamTemplate {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  name      String
  type      String?
  structure Json
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([schoolId])
  @@map("exam_templates")
}

model ExamScheduleNotification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId     String    @map("exam_id") @db.Uuid
  targetType String?   @map("target_type")
  sentAt     DateTime? @default(now()) @map("sent_at") @db.Timestamptz(6)
  channel    String?

  @@index([examId])
  @@map("exam_schedule_notifications")
}
