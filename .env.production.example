# Production environment template for modon-school.com (copy to .env.production
# on the server). No real secrets belong in this file.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3003
APP_URL=https://modon-school.com
NEXT_PUBLIC_APP_URL=https://modon-school.com
OFFICIAL_DOMAIN_URL=https://modon-school.com

# Supabase (modon-school project ONLY - never reuse another project's keys)
NEXT_PUBLIC_SUPABASE_URL=https://rljchldkgdbuhnkbuxqa.supabase.co
SUPABASE_URL=https://rljchldkgdbuhnkbuxqa.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# RBAC and health checks
RBAC_COOKIE_SECRET=<run: openssl rand -base64 48>
SESSION_COOKIE_SECURE=true
HEALTHCHECK_TOKEN=<run: openssl rand -base64 32>
# Encrypts stored temporary passwords for account cards (AES-256-GCM).
# Keep it stable: changing it makes existing stored passwords unreadable.
TEMP_PASSWORD_ENCRYPTION_KEY=<run: openssl rand -base64 32>

# Cron authentication (Vercel sends Authorization: Bearer $CRON_SECRET;
# OPS_ALERT_TOKEN is also accepted for manual runs). Used by
# /api/cron/account-deletion, /api/cron/scheduled-notifications, ...
CRON_SECRET=<run: openssl rand -hex 32>

# Rate limiting. REDIS_URL is read by ecosystem.config.cjs (PM2) when set;
# the Upstash REST pair is what lib/rate-limit.ts talks to (see docs/RATE_LIMIT_REDIS.md).
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_TRUSTED_PROXY_SECRET=

# Web push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@modon-school.com

# Ops / WhatsApp
OPS_ALERT_TOKEN=
OPS_REPORT_CRON_SECRET=
OPS_WHATSAPP_ENABLED=
OPS_DAILY_REPORT_ENABLED=

# Ops / Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPS_TELEGRAM_ENABLED=
# Telegram Bot Commands webhook secret (run: openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=

# Ops / Email
OPS_EMAIL_ENABLED=

# AI features (grade analysis, calendar suggestions, ops bot)
ANTHROPIC_API_KEY=
