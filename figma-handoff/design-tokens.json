      "color": "var(--text-secondary)"
    },
    "ui-button--danger": {
      "border": "1px solid rgba(240, 90, 90, 0.22)",
      "background": "rgba(240, 90, 90, 0.12)",
      "color": "var(--danger)"
    },
    "ui-pill": {
      "display": "inline-flex",
      "align-items": "center",
      "min-height": "34px",
      "border-radius": "var(--radius-pill)",
      "border": "1px solid var(--border)",
      "padding": "0.35rem 0.75rem"
    },
    "ui-table": {
      "width": "100%",
      "border-collapse": "separate",
      "border-spacing": "0"
    },
    "ui-grid-lines": {
      "background-image": "linear-gradient(to right, var(--grid-line) 1px, transparent 1px), linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px)",
      "background-size": "72px 72px"
    },
    "sk": {
      "background": "linear-gradient(90deg, rgba(79, 140, 255, 0.05) 25%, rgba(121, 215, 255, 0.16) 50%, rgba(79, 140, 255, 0.05) 75%)",
      "background-size": "600px 100%",
      "animation": "shimmer 1.35s ease-in-out infinite",
      "border-radius": "999px"
    }
  },

  "animation": {
    "shimmer": {
      "keyframes": {
        "0%": { "background-position": "-600px 0" },
        "100%": { "background-position": "600px 0" }
      },
      "duration": "1.35s",
      "timing-function": "ease-in-out",
      "iteration-count": "infinite"
    }
  },

  "misc": {
    "glass-blur": "22px",
    "grid-line": "rgba(79, 140, 255, 0.08)",
    "grid-line-dark": "rgba(138, 231, 255, 0.07)",
    "body-background": {
      "light": "radial-gradient(circle at top right, rgba(121, 215, 255, 0.18), transparent 28%), radial-gradient(circle at bottom left, rgba(79, 140, 255, 0.14), transparent 26%), linear-gradient(180deg, rgba(255, 255, 255, 0.52), rgba(245, 247, 251, 0.96)), var(--background)",
      "dark": "radial-gradient(circle at top right, rgba(138, 231, 255, 0.12), transparent 26%), radial-gradient(circle at bottom left, rgba(118, 169, 255, 0.12), transparent 28%), linear-gradient(180deg, rgba(9, 14, 28, 0.92), rgba(11, 16, 32, 1)), var(--background)"
    },
    "selection": {
      "background": "rgba(79, 140, 255, 0.2)",
      "color": "var(--text-primary)"
    },
    "scrollbar": {
      "width": "6px",
      "height": "6px",
      "thumb-radius": "var(--radius-full)",
      "thumb-color": "var(--border-strong)",
      "track-color": "transparent"
    }
  }
}
