import { createServerClient } from "@supabase/ssr";
import createIntlMiddleware from "next-intl/middleware";
import { NextResponse, type NextRequest } from "next/server";
import { routing } from "@/i18n/routing";

// ─── Public paths (no auth required) ───────────────────────────
const PUBLIC_PATHS = [
  "/login",
  "/student-login",
  "/forgot-password",
  "/privacy",
  "/terms",
  "/access-denied",
  "/account-deletion",
  "/verify",
];

const isPublicPath = (pathname: string): boolean => {
  // Strip locale prefix: /ar/login → /login
  const withoutLocale = pathname.replace(/^\/(ar|en)/, "") || "/";
  return (
    PUBLIC_PATHS.some((p) => withoutLocale.startsWith(p)) ||
    pathname.startsWith("/api/") ||
    pathname.startsWith("/_next/") ||
    pathname === "/favicon.ico" ||
    pathname === "/icon.png"
  );
};

// ─── next-intl middleware (handles locale routing) ─────────────
const intlMiddleware = createIntlMiddleware(routing);

// ─── Supabase cookie helper ────────────────────────────────────
function createSupabaseMiddlewareClient(request: NextRequest, response: NextResponse) {
  const supabaseUrl =
    process.env.NEXT_PUBLIC_SUPABASE_URL ||
    process.env.SUPABASE_URL ||
    "";
  const supabaseKey =
    process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY ||
    process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY ||
    process.env.SUPABASE_ANON_KEY ||
    process.env.SUPABASE_PUBLISHABLE_KEY ||
    "";

  return createServerClient(supabaseUrl, supabaseKey, {
    cookies: {
      getAll() {
        return request.cookies.getAll();
      },
      setAll(cookiesToSet) {
        cookiesToSet.forEach(({ name, value, options }) => {
          request.cookies.set(name, value);
          response.cookies.set(name, value, options);
        });
      },
    },
  });
}

// ─── Main middleware ───────────────────────────────────────────
export async function middleware(request: NextRequest) {
  // 1. Run next-intl first (handles locale detection & redirects)
  const intlResponse = intlMiddleware(request);
  const response = intlResponse || NextResponse.next({ request });

  // 2. Refresh Supabase auth session (keeps cookies alive)
  const supabase = createSupabaseMiddlewareClient(request, response);
  const {
    data: { user },
  } = await supabase.auth.getUser();

  // 3. Protect non-public routes
  if (!user && !isPublicPath(request.nextUrl.pathname)) {
    const locale = request.nextUrl.pathname.startsWith("/en") ? "en" : "ar";
    const loginUrl = new URL(`/${locale}/login`, request.url);
    loginUrl.searchParams.set("redirect", request.nextUrl.pathname);
    return NextResponse.redirect(loginUrl);
  }

  return response;
}

export const config = {
  matcher: [
    /*
     * Match all paths except:
     * - _next/static (static files)
     * - _next/image (image optimization)
     * - favicon.ico, icon.png
     * - api/health (health check)
     * - api/public/* (public endpoints)
     * - api/mobile/auth/* (mobile auth)
     * - api/ops/* (operations/cron)
     */
    "/((?!_next/static|_next/image|favicon\\.ico|icon\\.png|api/health|api/public|api/mobile/auth|api/ops|api/cron).*)",
  ],
};
